# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=orgname-accountname     # p. ej. abckbqz-wn68501 (de la URL app.snowflake.com/<org>/<account>)
SNOWFLAKE_USER=PSET2_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/pset2_rsa_key.p8   # key-pair (recomendado)
# SNOWFLAKE_PASSWORD=                 # solo si no usas key-pair
SNOWFLAKE_ROLE=PSET2_ROLE
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PSET2_MORA

# --- Kestra ---
KESTRA_USER=admin@kestra.io
KESTRA_PASSWORD=Admin1234
KESTRA_DB_PASSWORD=k3str4

# --- Versiones (opcional) ---
# KESTRA_IMAGE=kestra/kestra:v2.0.7
# SPARK_IMAGE=apache/spark:3.4.1
# DBT_IMAGE=ghcr.io/dbt-labs/dbt-snowflake:1.9.latest
